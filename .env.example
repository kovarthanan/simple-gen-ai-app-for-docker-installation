# Copy to .env. Values below work for running the backend locally (uvicorn) with
# `docker compose up -d qdrant neo4j`; docker-compose overrides the hostnames for containers.

# --- LLM: anthropic | openai | ollama ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings / reranking ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Knowledge graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- App DB (review queue, feedback, audit). SQLite locally, Postgres in Docker ---
DATABASE_URL=sqlite:///./rag_hitl.db

# --- Retrieval ---
VECTOR_TOP_K=5
GRAPH_DEPTH=1
FINAL_TOP_K=8

# --- Guardrails & human-in-the-loop ---
GUARDRAILS_POLICY_PATH=app/guardrails/config/policies.yaml
# HITL_CONFIDENCE_THRESHOLD=0.6     # overrides policies.yaml
REVIEWER_API_KEY=rag-review-2026
# HITL_WEBHOOK_URL=https://hooks.slack.com/services/...
